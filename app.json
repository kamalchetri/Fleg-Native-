{
  "expo": {
    "name": "FLEG Native UI Preview",
    "slug": "fleg-native-ui-preview",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050907",
    "icon": "./assets/icon.png",
    "android": {
      "package": "in.fleg.nativeapp.preview",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050907"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "ios": {
      "bundleIdentifier": "in.fleg.nativeapp.preview"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050907",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 210,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FLEG Native to scan authorized event accreditation QR codes.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
